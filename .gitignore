# =============================================================
# SatQuery AI — .gitignore
# =============================================================

# ---------------------------
# Python
# ---------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
*.egg

# ---------------------------
# Frontend / Node
# ---------------------------
node_modules/
.next/
.vinext/
out/
dist/
build/
.vite/
.turbo/
.parcel-cache/
tsconfig.tsbuildinfo
coverage/

# ---------------------------
# Secrets & Environment
# ---------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx


# OpenAI / Codex project metadata (may contain project IDs)
.openai/

# ---------------------------
# OS / IDE
# ---------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ---------------------------
# ML / Model Weights (large files)
# ---------------------------
*.ckpt
*.pth
*.pt
*.onnx
*.pb
*.tflite
*.bin
*.h5
*.hdf5
# Safetensors model weights (large)
# Note: adapter_config.json, README.md, provenance.json KEPT (small metadata)
models/satquery_change_v1/*.safetensors
models/satquery_rsvqa_v2/*.pt
models/stage8_5b_recovery/**/adapter_model.safetensors
models/satquery_rs_vlm_v1/**/adapter_model.safetensors
# HuggingFace model cache
models_cache/

# ---------------------------
# Datasets (large, reproducible)
# ---------------------------
# LEVIR-CD parquet splits (reproducible from HuggingFace)
data/levircd/*.parquet
# BigEarthNet parquet (448 MB, reproducible)
data/bigearthnet/*.parquet
# BigEarthNet raster images
data/bigearthnet/rasters/
# KEEP: data/manifests/*.json (small, important for reproducibility)

# ---------------------------
# Storage — runtime / generated
# ---------------------------
# Runtime uploaded images and generated outputs
storage/img_*.tif
storage/img_*.png
storage/img_*.jpg
storage/img_*.tiff
# Generated PDF analysis reports
storage/*.pdf
storage/satquery_report_*.pdf
storage/test_report_*.pdf
# SQLite runtime database
storage/satquery.db
storage/satquery.db-shm
storage/satquery.db-wal
# Generated change masks
storage/change_mask_*.png
# Generated previews directory
storage/previews/
# Accuracy validation output directory
storage/accuracy_validation/
# Real satellite verification output
storage/real_satellite_verification/
# Generated diagnostic cases
storage/diagnostic_cases/
# KEEP: storage/fixtures/ (demo fixtures)
# KEEP: storage/scenario_*.* (test fixtures)
# KEEP: storage/test_*.* (test fixtures)
# KEEP: storage/verif_*.* (verification fixtures)
# KEEP: storage/smoke_test_scene.tif
# KEEP: storage/flood_smoke_test.tif

# ---------------------------
# Logs & Temporary
# ---------------------------
*.log
*.log.*
logs/
tmp/
temp/
.cache/
.tmp/

# ---------------------------
# Deployment / CI
# ---------------------------
.vercel
.wrangler/
.openai/

# ---------------------------
# Build / Compiled Assets
# ---------------------------
# Vite / Next.js build output (contains absolute machine paths)
/dist/
/.next/
/.vinext/

# ---------------------------
# Graphify / Tool caches
# ---------------------------
graphify-out/

# ---------------------------
# Wandb / MLflow / experiment trackers
# ---------------------------
wandb/
mlruns/
runs/
checkpoints/
lightning_logs/

# ---------------------------
# Misc development artifacts
# ---------------------------
walkthrough.md
*.tsbuildinfo
