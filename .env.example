# ===================================================
# SatQuery AI — Environment Configuration Template
# ===================================================
# Copy this file to .env before first run:
#   cp .env.example .env
#
# NEVER commit .env with real values.
# ===================================================

# Environment mode: development | staging | production
APP_ENV=development

# Backend Server
API_HOST=0.0.0.0
API_PORT=8000

# Frontend API Target (Next.js public variable)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local Storage Directory for Ingested GeoTIFF / Images
# Must be writable; relative to repo root
STORAGE_DIR=./storage

# SQLite Database Path (relative to repo root)
DATABASE_URL=sqlite:///./storage/satquery.db

# Hugging Face token — required to load base VLM weights
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Hardware compute execution
# Options: cpu | cuda | mps
DEVICE=cpu
CUDA_VISIBLE_DEVICES=0

# Model & HuggingFace cache directory (relative to repo root)
MODEL_CACHE_DIR=./models_cache

# Gemini API Key — used by the frontend planner / prompt executor
# Get one at https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI key if using OpenAI provider
OPENAI_API_KEY=your_openai_api_key_here
