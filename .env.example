# =============================================================
# SatQuery AI — Environment Template (.env.example)
# Copy this file to .env and replace placeholder values.
# =============================================================

# Server Environment
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Backend AI Provider Keys (Optional / Server-side)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
HF_TOKEN=your_huggingface_token_here

# Hardware Device Configuration (cpu, cuda, mps)
DEVICE=cpu

# Frontend Production API URL (Configurable for Vercel deployment)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000
